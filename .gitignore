# Dépendances Node.js (trop lourdes pour Git)
node_modules/

# Fichier de variables d'environnement locales (contient vos mots de passe secrets)
.env

# Documents déposés par les promoteurs (fichiers utilisateurs, pas du code)
backend/uploads/

# Fichiers de logs et temporaires
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
# Réseau Fabric — matériel cryptographique et données générées (jamais versionnés)
blockchain/fabric-network/test-network/organizations/peerOrganizations/
blockchain/fabric-network/test-network/organizations/ordererOrganizations/
blockchain/fabric-network/test-network/organizations/fabric-ca/*/msp/
blockchain/fabric-network/test-network/organizations/fabric-ca/*/tls-cert.pem
blockchain/fabric-network/test-network/organizations/fabric-ca/*/ca-cert.pem
blockchain/fabric-network/test-network/organizations/fabric-ca/*/IssuerPublicKey
blockchain/fabric-network/test-network/organizations/fabric-ca/*/IssuerRevocationPublicKey
blockchain/fabric-network/test-network/organizations/fabric-ca/*/fabric-ca-server.db
blockchain/fabric-network/test-network/channel-artifacts/
blockchain/fabric-network/test-network/system-genesis-block/
blockchain/fabric-network/test-network/*.tar.gz
blockchain/fabric-network/bin/
blockchain/fabric-network/config/

# Build TypeScript du chaincode
blockchain/chaincode/parcelle/dist/

# Fichiers macOS/Windows
Thumbs.db

# fabric-samples : on ne garde que test-network et le script d'installation
blockchain/fabric-network/*
!blockchain/fabric-network/test-network/
!blockchain/fabric-network/install-fabric.sh
