# Base de données PostgreSQL + PostGIS
DB_HOST=localhost
DB_PORT=5433
DB_NAME=fonciersur_dev
DB_USER=fonciersur_dev
DB_PASSWORD=fonciersur_dev_password

# Authentification
JWT_SECRET=
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Seed (création des comptes de démonstration Promoteur/Cadastre/Notaire)
SEED_PASSWORD=

# Port du backend unique (monolithe)
PORT=5000
NODE_ENV=development

# Hyperledger Fabric
# USE_MOCK_BLOCKCHAIN=true permet de développer/tester sans réseau Fabric
# lancé ; la garde de sécurité dans blockchainService.js EMPÊCHE true en
# production (NODE_ENV=production + USE_MOCK_BLOCKCHAIN=true => erreur).
USE_MOCK_BLOCKCHAIN=true
FABRIC_NETWORK_PATH=
FABRIC_CHANNEL=fonciersur-channel
FABRIC_CHAINCODE=parcelle
